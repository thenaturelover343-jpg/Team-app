rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function active() { return signedIn() && request.auth.token.active == true; }
    function admin() { return active() && request.auth.token.role == 'admin'; }
    function owner(userId) { return active() && request.auth.uid == userId; }
    function validId(id) { return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function validTime(value) { return value is timestamp || value is number; }
    function validLocation(value) {
      return value is map
        && value.keys().hasAll(['lat', 'lng'])
        && value.keys().hasOnly(['lat', 'lng', 'accuracy', 'capturedAt'])
        && value.lat is number && value.lat >= -90 && value.lat <= 90
        && value.lng is number && value.lng >= -180 && value.lng <= 180
        && (!('accuracy' in value) || (value.accuracy is number && value.accuracy >= 0 && value.accuracy <= 10000))
        && (!('capturedAt' in value) || value.capturedAt is number);
    }

    match /users/{userId} {
      function validUser(data) {
        return data.keys().hasAll(['name', 'email', 'role', 'active', 'createdAt'])
          && data.keys().hasOnly(['name', 'email', 'role', 'active', 'createdAt', 'updatedAt', 'phone', 'availability'])
          && data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.email is string && data.email.size() > 3 && data.email.size() <= 255
          && data.role in ['admin', 'employee']
          && data.active is bool
          && validTime(data.createdAt)
          && (!('updatedAt' in data) || validTime(data.updatedAt))
          && (!('phone' in data) || (data.phone is string && data.phone.size() <= 50))
          && (!('availability' in data) || (data.availability is string && data.availability.size() <= 1000));
      }

      allow get: if owner(userId) || admin();
      allow list: if admin();
      allow create, delete: if false;
      allow update: if owner(userId)
        && validUser(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'availability', 'updatedAt'])
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.active == resource.data.active
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /shifts/{shiftId} {
      allow read: if owner(resource.data.userId) || admin();
      allow create, update, delete: if false;
    }

    match /active_shifts/{userId} {
      allow read: if owner(userId) || admin();
      allow create, update, delete: if false;
    }

    match /time_events/{eventId} {
      allow read: if owner(resource.data.userId) || admin();
      allow create, update, delete: if false;
    }

    match /audit_events/{eventId} {
      allow read: if admin();
      allow create, update, delete: if false;
    }

    match /assignments/{assignmentId} {
      function validAssignment(data) {
        return validId(assignmentId)
          && data.keys().hasAll(['userId', 'customerId', 'customerName', 'description', 'date', 'status', 'createdAt'])
          && data.keys().hasOnly(['userId', 'customerId', 'customerName', 'description', 'date', 'startTime', 'status', 'arrivalTime', 'departureTime', 'arrivalLoc', 'departureLoc', 'workNotes', 'tasks', 'acknowledged', 'acknowledgedAt', 'createdAt'])
          && validId(data.userId) && validId(data.customerId)
          && data.customerName is string && data.customerName.size() <= 200
          && data.description is string && data.description.size() <= 1000
          && data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && data.status in ['pending', 'arrived', 'completed']
          && validTime(data.createdAt)
          && (!('startTime' in data) || (data.startTime is string && data.startTime.matches('^([01]\\d|2[0-3]):[0-5]\\d$')))
          && (!('arrivalTime' in data) || validTime(data.arrivalTime))
          && (!('departureTime' in data) || validTime(data.departureTime))
          && (!('arrivalLoc' in data) || validLocation(data.arrivalLoc))
          && (!('departureLoc' in data) || validLocation(data.departureLoc))
          && (!('workNotes' in data) || (data.workNotes is string && data.workNotes.size() <= 2000))
          && (!('acknowledged' in data) || data.acknowledged is bool)
          && (!('acknowledgedAt' in data) || validTime(data.acknowledgedAt))
          && (!('tasks' in data) || (data.tasks is list && data.tasks.size() <= 50));
      }

      allow read: if owner(resource.data.userId) || admin();
      allow create: if false;
      allow update: if owner(resource.data.userId)
          && validAssignment(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workNotes', 'tasks']);
      allow delete: if false;
    }

    match /customers/{customerId} {
      function validCustomer(data) {
        return validId(customerId)
          && data.keys().hasAll(['name', 'address', 'createdAt'])
          && data.keys().hasOnly(['name', 'address', 'phone', 'email', 'createdAt'])
          && data.name is string && data.name.size() > 0 && data.name.size() <= 200
          && data.address is string && data.address.size() > 0 && data.address.size() <= 500
          && validTime(data.createdAt)
          && (!('phone' in data) || (data.phone is string && data.phone.size() <= 50))
          && (!('email' in data) || (data.email is string && data.email.size() <= 255));
      }
      allow read: if admin();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
