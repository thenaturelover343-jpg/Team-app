# Public Firebase web configuration. These values identify the project; access is
# enforced by Authentication, App Check and Firestore Security Rules.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIRESTORE_DATABASE_ID="(default)"

# Create separate reCAPTCHA Enterprise/v3 keys for staging and production.
VITE_RECAPTCHA_SITE_KEY=""

# Set to true only while using the local Firebase Emulator Suite.
VITE_USE_FIREBASE_EMULATORS="false"
